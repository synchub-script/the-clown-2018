-- 1. ESP (Исправленный)
local espEnabled = false
local espObjects = {}
local espFolder = Instance.new("Folder", game.CoreGui)
espFolder.Name = "ClownESP"

local function CreateESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end
    
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Используем Highlight для лучшей видимости
    local highlight = Instance.new("Highlight")
    highlight.Name = "ClownHighlight"
    highlight.FillColor = Color3.fromRGB(255, 60, 120)
    highlight.OutlineColor = Color3.fromRGB(255, 150, 200)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = char
    
    -- Добавляем имя и дистанцию через BillboardGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ClownBillboard"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = char.Head or hrp
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 150, 200)
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.Parent = billboard
    
    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0, 20)
    distLabel.Position = UDim2.new(0, 0, 0, 20)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLabel.TextSize = 12
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextStrokeTransparency = 0.5
    distLabel.Parent = billboard
    
    espObjects[player] = {Highlight = highlight, Billboard = billboard, DistLabel = distLabel}
end

local function ToggleESP(state)
    espEnabled = state
    if state then
        for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
        Players.PlayerAdded:Connect(function(p) if espEnabled then task.wait(1); CreateESP(p) end end)
        -- Обновление дистанции
        task.spawn(function()
            while espEnabled do
                for p, objs in pairs(espObjects) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                        if objs.DistLabel then objs.DistLabel.Text = dist .. "m" end
                    end
                end
                task.wait(0.2)
            end
        end)
    else
        for _, objs in pairs(espObjects) do
            if objs.Highlight then objs.Highlight:Destroy() end
            if objs.Billboard then objs.Billboard:Destroy() end
        end
        espObjects = {}
    end
end

-- 2. Teleport (Исправленный)
local teleporting = false
local function ToggleTeleport()
    teleporting = not teleporting
    if teleporting then
        task.spawn(function()
            while teleporting do
                for _, p in ipairs(Players:GetPlayers()) do
                    if not teleporting then break end
                    if p ~= LocalPlayer and p.Character and LocalPlayer.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp and myHrp then
                            myHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 4) -- Чуть дальше, чтобы не застрять
                        end
                    end
                    task.wait(2)
                end
            end
        end)
    end
end

-- 3. Fling (Исправленный через BodyVelocity)
local function FlingAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp then
                -- Создаём BodyVelocity с огромной силой (метод из рабочего примера)
                local bv = Instance.new("BodyVelocity")
                bv.Velocity = Vector3.new(0, 500, 0) -- Сила вверх
                bv.MaxForce = Vector3.new(0, math.huge, 0)
                bv.Parent = hrp
                
                -- Дополнительно раскручиваем
                if humanoid then
                    humanoid.PlatformStand = true
                end
                
                task.delay(0.5, function()
                    if bv then bv:Destroy() end
                    if humanoid then humanoid.PlatformStand = false end
                end)
            end
        end
    end
end

